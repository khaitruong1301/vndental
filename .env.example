# Sao chép thành .env rồi điền giá trị

# Postgres (Docker) — superuser
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ClinicCybersoftDB — DB của ứng dụng phòng khám
CLINIC_DB_NAME=ClinicCybersoftDB
CLINIC_DB_USER=
CLINIC_DB_PASSWORD=

# Backend API
API_PORT=4000
JWT_SECRET=
