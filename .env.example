# Sao chép thành .env rồi điền giá trị

# Postgres (Docker) — superuser
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ClinicCybersoftDB — DB của ứng dụng phòng khám
CLINIC_DB_NAME=ClinicCybersoftDB
CLINIC_DB_USER=
CLINIC_DB_PASSWORD=

# Backend API
API_PORT=4000
JWT_SECRET=

# --- Production (đặt trong .env.production hoặc biến môi trường của host) ---
# NODE_ENV=production
# DATABASE_URL=postgresql://<user>:<pass>@<host>/ClinicCybersoftDB?sslmode=verify-full
# JWT_SECRET=<chuỗi ngẫu nhiên ≥ 32 ký tự>
# PORT=            (host tự cấp)
# UPLOAD_DIR=      (thư mục lưu file bệnh nhân, nên là ổ đĩa bền vững)
# Frontend: BACKEND_URL=https://<địa-chỉ-api>
