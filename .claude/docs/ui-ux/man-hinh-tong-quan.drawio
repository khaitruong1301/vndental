w=block;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#0f766e;fontColor=#0f766e;" edge="1" parent="1" source="c22" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="⑤ lập hóa đơn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#0f766e;fontColor=#0f766e;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="⑥ thu tiền → in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#0f766e;fontColor=#0f766e;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="HĐ liệu trình" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#94a3b8;dashed=1;fontColor=#64748b;" edge="1" parent="1" source="c25" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="cảnh báo kho" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#94a3b8;dashed=1;fontColor=#64748b;" edge="1" parent="1" source="c7" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Ghi chú:&lt;/b&gt; Đường liền xanh = luồng nghiệp vụ chính ①→⑥ (xem trang 2). Đường nét đứt = điều hướng phụ. Menu bên trái chỉ hiện các màn hình mà vai trò có quyền (theo bảng role_permissions, mã use case). Use case hệ thống (LH-07 kiểm tra xung đột, DT-06 trừ vật tư, DT-09 ghi lịch sử, TT-02 áp giá) chạy tự động trong DB, không có màn hình riêng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="1200" width="1500" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Luồng nghiệp vụ" id="50436047"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;LUỒNG MỘT LƯỢT KHÁM: từ đặt lịch đến chốt két&lt;/b&gt; — mỗi bước ghi màn hình và use case" style="text;html=1;align=left;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Lễ tân&lt;/b&gt;" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#2563eb;fontColor=#ffffff;swimlaneFillColor=#eff6ff;strokeColor=#2563eb;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1850" height="170" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Bác sĩ&lt;/b&gt;" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#0d9488;fontColor=#ffffff;swimlaneFillColor=#f0fdfa;strokeColor=#0d9488;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1850" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Hệ thống (DB tự động)&lt;/b&gt;" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#64748b;fontColor=#ffffff;swimlaneFillColor=#f8fafc;strokeColor=#64748b;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="1850" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Quản lý&lt;/b&gt;" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#7c3aed;fontColor=#ffffff;swimlaneFillColor=#f5f3ff;strokeColor=#7c3aed;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1850" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Tìm / đăng ký BN&lt;/b&gt;&lt;br&gt;&lt;font color='#0f766e' face='Courier New' style='font-size:9px;'&gt;/patients&lt;/font&gt;&lt;br&gt;&lt;font color='#b45309'